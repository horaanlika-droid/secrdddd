# скопируйте в .env и заполните: cp .env.example .env
# бот в контейнере: docker compose up -d --build

# токен бота от @BotFather (обязательно)
TG_TOKEN=

# id админов через запятую (обязательно)
ADMIN_IDS=

# ключ Tribute API: кабинет Tribute → меню (три точки) → Settings → API Keys.
# Нужен, чтобы проверять подпись вебхуков (без него подписки не активируются).
TRIBUTE_API=

# Ссылка оплаты хранится в базе и меняется админом прямо в боте:
#   /tribute set https://t.me/tribute/app?startapp=dQui
# Перезапуск не нужен. В Tribute создай Donation Request с ежемесячным периодом
# и минимальным донатом. Необязательный fallback для пустой/новой базы:
# v35: обе ссылки (разовый и ежемесячный) — один Donation Request dQui;
# дефолт dQui уже вшит в bot/src/tribute.js (REPO_PAY_URL).
# TRIBUTE_MONTHLY_URL=https://t.me/tribute/app?startapp=dQui
# Проверить текущую ссылку, ключ и webhook: /tribute

# ключ OpenAI — «живой» чат Дибитишки (можно позже: без него чат в локальном режиме)
# Проверить ключ и модель, не поднимая руками: npm run ai-check   (или /diag в Telegram)
OPENAI_API_KEY=
# необязательно: модель и адрес API
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# для ключа, привязанного к проекту, нужен id проекта:
# OPENAI_PROJECT=proj_...
# тонкая настройка запроса (обычно не нужна):
# OPENAI_MAX_TOKENS=700        # потолок ответа
# OPENAI_TEMPERATURE=0.8       # для reasoning-моделей (o*/gpt-5*) игнорируется автоматически
# OPENAI_TIMEOUT_MS=45000      # через сколько считать, что модель не успела
# AI_HISTORY=20                # сколько реплик диалога помнить

# публичный POST /chat открыт всему вебу — на случай скриптов-нагрузчиков
# ставим лимит запросов в минуту на один IP (0 = не ограничивать не стоит)
# CHAT_RATE_PER_MIN=20
# DIAG_PUBLIC=1 — отдавать /chat/status подробности (ai_health, polling).
# По выключении техническая причина уходит только админу в Telegram.
# DIAG_PUBLIC=0

# ------------------------------------------------------------
# «Агент с сессией и окружением» (Agents API) — необязательный бэкенд
# По умолчанию выключен: чат ходит в chat/completions (быстро и дёшево).
# Включён — у диалога появляется persistent-сессия и изолированное
# окружение, где агент может читать файлы и запускать код.
# Контракт и порядок запуска — docs/SETUP.md («Агенты: сессия и окружение»).
# ------------------------------------------------------------
# AGENTS_ENABLED=1
# AGENTS_MODEL=gpt-4o-mini
# AGENTS_BASE_URL=https://api.openai.com/v1
# AGENTS_WORKSPACE=/workspace
# ключ окружения (НЕ приложения): platform.openai.com/agents → Environments →
# Keys; все права кроме подключения — None. Уходит исполнителю как CODEX_API_KEY.
# OPENAI_EXECUTOR_API_KEY=
# как запускать исполнителя окружения; плейсхолдеры {remote_url} {environment_id}
# (их отдаёт API при создании сессии; у каждой сессии — свои, и свой исполнитель)
# AGENTS_EXECUTOR_CMD=codex exec-server --remote "{remote_url}" --environment-id "{environment_id}"
# docker-вариант:
# AGENTS_EXECUTOR_CMD=docker run --rm -i agent-api-sandbox:latest codex exec-server --remote "{remote_url}" --environment-id "{environment_id}"
# AGENTS_TURN_TIMEOUT_MS=90000      # сколько ждать завершения хода
# AGENTS_CONNECT_TIMEOUT_MS=45000
# AGENTS_SESSION_TTL_S=3600         # через сколько бездействия закрыть сессию
# AGENTS_MAX_CHARS=1800             # потолок длины ответа для чата

# порт HTTP API для веб-версии (по умолчанию 8080)
# PORT=8080

# ------------------------------------------------------------
# Доски впечатлений (v26). Приватный API включён по умолчанию;
# человек включает синхронизацию отдельно на странице досок.
# ВАЖНО: каталог должен быть на постоянном диске, а не внутри временного контейнера.
# По умолчанию: board-data/ рядом с DB_FILE (в Docker: /data/board-data).
# BOARDS_ENABLED=1
# BOARDS_DATA_DIR=/data/board-data
# Фото по умолчанию тоже в BOARDS_DATA_DIR. Необязательный закрытый S3/R2 бакет:
# BOARDS_S3_ENDPOINT=https://ACCOUNT.r2.cloudflarestorage.com
# BOARDS_S3_BUCKET=dibitishka-private
# BOARDS_S3_REGION=auto
# BOARDS_S3_ACCESS_KEY=
# BOARDS_S3_SECRET_KEY=
# Ключи вводятся только в окружении хоста, никогда в app/config.js.
# Даже при S3 метаданные/сессии требуют постоянного DB_FILE и BOARDS_DATA_DIR.

# Поиск GIF в приложении. Без ключа работает вставка ссылки и переход в Tenor.
# TENOR_API_KEY=
