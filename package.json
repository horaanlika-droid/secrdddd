{
  "name": "dibitishka",
  "version": "1.0.0",
  "private": true,
  "description": "дибитишка: веб-приложение (app/) и телеграм-бот (bot/). Корневой package.json нужен хостам, которые ставят зависимости в корне репозитория, — node найдёт их из bot/src поиском вверх по папкам.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bot/src/index.js",
    "bot": "node bot/src/index.js",
    "check": "node bot/src/ensure-deps.js --check && node scripts/check-project.mjs",
    "smoke": "node scripts/smoke.mjs",
    "port": "node scripts/port-clash.mjs",
    "verify": "npm run check && npm run dom-test && npm run boards-test && npm run tribute-test && npm run ai-test && npm run agents-test && npm run smoke && npm run port && npm run workbook-test && npm run stickers-test",
    "ai-check": "node scripts/ai-check.mjs",
    "ai-test": "node scripts/ai-params-check.mjs",
    "agents-test": "node scripts/agents-mock-check.mjs",
    "tribute-test": "node scripts/tribute-check.mjs",
    "dom-test": "node --experimental-vm-modules scripts/dom-smoke.mjs",
    "boards-test": "node scripts/boards-test.mjs",
    "browser-test": "node scripts/browser-smoke.mjs",
    "workbook-test": "node scripts/workbook-test.mjs",
    "stickers-test": "node scripts/stickers-test.mjs"
  },
  "dependencies": {
    "grammy": "^1.30.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0"
  }
}
